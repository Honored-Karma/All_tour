{
  "name": "all-tour",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsx scripts/prerender.tsx && node scripts/verify-build.mjs",
    "preview": "node scripts/preview.mjs",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "sitemap": "tsx scripts/prerender.tsx",
    "predev": "npm run assets",
    "assets": "node scripts/optimize-media.mjs",
    "prebuild": "npm run assets",
    "content:edit": "tsx scripts/content-editor.ts",
    "dev:site": "vite --port=3000 --host=127.0.0.1",
    "leads": "tsx server/leadServer.ts",
    "leads:backup": "node scripts/backup-leads.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wawoff2": "^2.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
